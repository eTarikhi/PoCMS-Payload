# PoCMS environment variables. Copy to `.env` and fill in the values.
# Never commit `.env`. Variable names match src/payload.config.ts and the frontend.

# Required. Secret used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Required. PostgreSQL connection string. Local databases (localhost / 127.0.0.1) are reached
# with `pg`; anything else goes through @vercel/postgres (Vercel Postgres / Neon).
# docker compose: postgres://postgres:postgres@127.0.0.1:5432/pocms
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/pocms

# Optional. Direct (non-pooled) connection for the database tools at /admin/database: backups,
# VACUUM and REINDEX. Leave empty to use POSTGRES_URL. On Neon the pooled endpoint ends in
# "-pooler"; the direct one is the same host without it (Neon console > Connection string).
DATABASE_DIRECT_URL=

# Canonical public URL of the site. Used for absolute URLs (SEO, JSON-LD, sitemap), by the admin
# "View site" link and as the site the Page speed widget tests (local addresses are skipped; on
# Vercel the widget falls back to the production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Vercel Blob read/write token for the `media` collection. When empty, uploads are
# stored on the local disk (./media), which is what you want in development.
BLOB_READ_WRITE_TOKEN=

# Optional. Resend API key for transactional email (password reset, verification).
RESEND_API_KEY=

# Optional, development only. Extra hostnames allowed to load the dev server, e.g. a tunnel or a
# cloud IDE preview host. Comma-separated, wildcards allowed: "*.example.dev,my-tunnel.io"
DEV_ALLOWED_ORIGINS=

# Optional. Admin dashboard integrations (docs/ui-modernization/dashboard-integrations.md). Each
# widget shows a setup hint until its variables are set; tokens stay on the server.
# Vercel: Site traffic (Web Analytics API) and Deployments widgets. Create a token under
# Account Settings > Tokens; the project ID is in Project Settings > General. VERCEL_TEAM_ID (or
# VERCEL_TEAM_SLUG) is needed for team projects only.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Google: Page speed widget. One API key whose Google Cloud project has the "PageSpeed Insights
# API" (Lighthouse lab test) and the "Chrome UX Report API" (real-user data) enabled: Google Cloud
# console > APIs & Services > Library, then Credentials > Create credentials > API key. The admin
# calls Google from the server: leave the key's application restriction at None and restrict it
# to those two APIs, or allow the site's domain under website restrictions.
GOOGLE_API_KEY=

# Optional. Neon API for the branch operations on /admin/database: a branch backup pinned to a
# moment, point-in-time restore, deleting a backup branch. Without a key the page says so and links
# to the console; everything else on it works on any Postgres. Create the key under Account
# settings > API keys. NEON_PROJECT_ID and NEON_BRANCH_ID skip the lookup that matches this
# database's endpoint to its project (useful when the key can see several projects).
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Scheduled maintenance (CR-12 E4). Vercel Cron calls GET /api/jobs/cron once a day and sends
# "Authorization: Bearer $CRON_SECRET" when this is set. Without it, scheduled runs are disabled and
# only the Run now buttons on /admin/jobs work. TRASH_RETENTION_DAYS is how long trashed documents
# are kept before the daily trash job deletes them for good (default 30).
CRON_SECRET=
TRASH_RETENTION_DAYS=

# Nightly database dumps (the `database-backup` job on /admin/jobs). The directory is relative to
# the repository, and is git-ignored. KEEP is how many dumps are retained — the newest always
# survive, whatever their names are. FORMAT is `sql` (restores through the Restore card or
# `pnpm db:restore`) or `json` (the format the schema comparison reads).
#
# On a serverless deployment the filesystem does not outlive the request, and the job says so in its
# own summary: there, take a Neon backup branch instead (the Neon card on /admin/database), which is
# point-in-time restorable rather than a dump.
BACKUP_DIR=
BACKUP_KEEP=
BACKUP_FORMAT=

# GitHub: CI status widget. The repository ("owner/name"); on Vercel it is read from the git system
# variables when this is empty. GITHUB_TOKEN (fine-grained, read-only Actions) for private
# repositories and a higher rate limit.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
