# ==============================================================================
# PoCMS-Payload — Environment Configuration Template
# ==============================================================================
# Quick Start for New Developers:
#   1. Copy this file to `.env`:  cp .env.example .env
#   2. Replace `PAYLOAD_SECRET` with a fresh 64-character hex string (command below).
#   3. Ensure PostgreSQL is running at `POSTGRES_URL`, then start with `pnpm dev`.
#
# Security Note:
#   Never commit `.env` or real credentials to Git. Optional cloud integrations
#   default to empty (`KEY=`) so local development works offline out of the box.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Node.js & Next.js Core Runtime (`next@16.3.8`, `cross-env`, `Dockerfile`)
# ------------------------------------------------------------------------------

# Purpose: Controls the runtime execution mode for Next.js, Payload CMS, security
#          headers, GraphQL introspection lockdown, and dev-only admin tools.
# Type: String (Enum)
# Format: Must be one of `development`, `production`, or `test`.
# Example / Default: `development` locally; `production` in Docker/Vercel builds.
NODE_ENV=development

# Purpose: TCP port bound by the Next.js HTTP server in local dev or standalone Docker runs.
# Type: Integer
# Format: Valid unprivileged TCP port number between `1024` and `65535`.
# Example / Default: `3000` (e.g., `3000` or `4000`).
PORT=3000

# Purpose: Network interface address bound by the standalone Next.js production server.
# Type: String (Hostname / IPv4 / IPv6)
# Format: Valid IP address or hostname without protocol or port (`0.0.0.0` for containers).
# Example / Default: `localhost` locally; `0.0.0.0` inside Docker / cloud sandboxes.
HOSTNAME=localhost

# Purpose: Canonical public base URL of the portfolio website. Used for SEO canonicals,
#          Open Graph tags, JSON-LD structured data, `/sitemap.xml`, `/robots.txt`,
#          `/feed.xml`, Admin "View site" links, and PageSpeed Insights checks.
# Type: URL
# Format: Full `http://` or `https://` origin URL WITHOUT a trailing slash.
# Example / Default: `http://localhost:3000` locally; `https://vtarikhi.com` in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Purpose: Extra hostnames permitted to load `/_next/*` dev assets in `next.config.ts`
#          (`allowedDevOrigins`) when previewing via tunnels or cloud IDEs.
# Type: String (Comma-separated hostname list)
# Format: Comma-separated bare hostnames or leading-wildcard domains (no `https://` scheme).
# Example / Default: Leave empty locally, or `*.e2b.app,*.ngrok-free.app,preview.local`.
DEV_ALLOWED_ORIGINS=

# Purpose: Opts out of anonymous Next.js CLI and build telemetry collection.
# Type: Integer / Boolean flag
# Format: Set to `1` (or `true`) to disable telemetry; leave empty or `0` to keep default.
# Example / Default: `1` (recommended in CI and Docker builds).
NEXT_TELEMETRY_DISABLED=1

# Purpose: Activates `output: 'standalone'` in `next.config.ts` when building self-contained
#          production Docker images (`Dockerfile` sets this automatically in the builder stage).
# Type: Boolean
# Format: Lowercase boolean string (`true` or `false`).
# Example / Default: `false` on Vercel / local dev; `true` inside Docker builds.
DOCKER_BUILD=false

# Purpose: Server-side emergency kill-switch that bypasses injecting custom `<head>`, CSS,
#          after-footer, and `<body>` snippets from the `Site settings -> Codes` global.
# Type: Boolean
# Format: Lowercase boolean string (`true` or `false`).
# Example / Default: `false` (set to `true` only to recover from a broken custom snippet).
DISABLE_CUSTOM_CODE_INJECTION=false

# Purpose: Browser-exposed companion kill-switch halting client-side `<script>` execution
#          in `CustomCodeClient` when custom code injection must be suppressed immediately.
# Type: Boolean
# Format: Lowercase boolean string (`true` or `false`).
# Example / Default: `false` (keep synchronized with `DISABLE_CUSTOM_CODE_INJECTION`).
NEXT_PUBLIC_DISABLE_CUSTOM_CODE=false


# ------------------------------------------------------------------------------
# 2. Payload CMS Core, Auth & Scheduled Jobs (`payload@3.90.2`, `jsonwebtoken`)
# ------------------------------------------------------------------------------

# Purpose: Master cryptographic secret used by Payload CMS to sign JWT auth cookies,
#          CSRF tokens, draft preview sessions, and fallback AES-256-GCM DB backups.
# Type: String (High-entropy secret)
# Format: Minimum 16 characters in production (enforced at boot); 64-char hex string
#         generated via `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` is recommended.
# Example / Default: Replace below before deploying (e.g., `9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08`).
PAYLOAD_SECRET=pocms-local-dev-secret-change-before-production-32chars

# Purpose: Filesystem path to the Payload configuration file used by CLI & codegen scripts.
# Type: String (File path)
# Format: Relative path from repository root or absolute path ending in `.ts` / `.js`.
# Example / Default: `src/payload.config.ts`.
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# Purpose: Shared Bearer token authenticating external cron runners (e.g., Vercel Cron)
#          invoking Payload's scheduled Jobs Queue (`Authorization: Bearer <CRON_SECRET>`).
# Type: String (Secret token)
# Format: URL-safe random alphanumeric/hex string (32+ characters recommended, no spaces).
# Example / Default: Leave empty locally, or `cron_7b91e4f2c80a4d1698e3b05f12a7c4d9`.
CRON_SECRET=


# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (`@payloadcms/db-vercel-postgres`, `@payloadcms/db-postgres`, `pg`)
# ------------------------------------------------------------------------------

# Purpose: Primary PostgreSQL connection URI used by Payload's Drizzle/Postgres adapter
#          (`localhost` uses direct `pg` pool; remote hosts support Neon/Vercel PgBouncer).
# Type: URL (PostgreSQL DSN)
# Format: `postgres://<user>:<password>@<host>:<port>/<database>[?sslmode=require]`
# Example / Default: `postgres://postgres:postgres@127.0.0.1:5432/pocms` locally;
#                    `postgresql://user:pass@ep-cool-sky-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require` on Neon.
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/pocms

# Purpose: Direct, unpooled PostgreSQL connection URI (bypassing PgBouncer `-pooler`) used
#          by `/admin/database` (`VACUUM`, `REINDEX`, sequence repair, atomic restores) and
#          by `/api/mail/stream` for real-time PostgreSQL `LISTEN/NOTIFY` inbox updates.
# Type: URL (PostgreSQL DSN)
# Format: `postgresql://<user>:<password>@<direct-host>:<port>/<database>?sslmode=require` (no `-pooler` hostname).
# Example / Default: Leave empty locally (falls back to `POSTGRES_URL`), or
#                    `postgresql://user:pass@ep-cool-sky-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require`.
POSTGRES_URL_NON_POOLING=

# Purpose: Optional Neon-native alias fallback for `POSTGRES_URL_NON_POOLING` recognized by
#          connection diagnostics, database repair tools, and the Mail SSE listener.
# Type: URL (PostgreSQL DSN)
# Format: Direct PostgreSQL URI without `-pooler` or `pgbouncer=true`.
# Example / Default: Leave empty when `POSTGRES_URL_NON_POOLING` is already set.
DATABASE_URL_UNPOOLED=

# Purpose: Controls whether Drizzle automatically pushes schema changes during `NODE_ENV=test`
#          runs (`vitest`). Kept `false` by default so interactive prompts never hang CI.
# Type: Boolean
# Format: Lowercase boolean string (`true` or `false`).
# Example / Default: `false`.
PAYLOAD_DB_PUSH=false


# ------------------------------------------------------------------------------
# 4. Cloud Object Storage & Backup Vault (`@payloadcms/storage-vercel-blob`, `@vercel/blob`)
# ------------------------------------------------------------------------------

# Purpose: Activates Vercel Blob cloud storage for public `media` uploads (with client uploads
#          bypassing 4.5 MB serverless limits), private RBAC-gated `mail-attachments`, and
#          fallback cloud database backups. When empty, files are stored locally under `./media`.
# Type: String (Vercel Blob Token)
# Format: Must strictly match `vercel_blob_rw_<store_id>_<random_string>` when non-empty
#         (an invalid non-empty format will throw at Payload startup).
# Example / Default: Leave empty locally; in production use `vercel_blob_rw_<storeid>_<token>` (e.g., `vercel_blob_rw_store01_example`).
BLOB_READ_WRITE_TOKEN=

# Purpose: Optional base URL override for `@payloadcms/storage-vercel-blob` when testing
#          against a local `vercel-blob-emulator` instance instead of Vercel's CDN.
# Type: URL
# Format: Full `http://` or `https://` origin URL without trailing slash.
# Example / Default: Leave empty in normal dev/prod, or `http://localhost:4100` with an emulator.
STORAGE_VERCEL_BLOB_BASE_URL=

# Purpose: Optional dedicated Vercel Blob read/write token isolating encrypted database
#          backups (`/admin/database`) in a separate Blob store from public `media` assets.
# Type: String (Vercel Blob Token)
# Format: `vercel_blob_rw_<store_id>_<random_string>` (falls back to `BLOB_READ_WRITE_TOKEN` when empty).
# Example / Default: Leave empty, or `vercel_blob_rw_<dbvault_id>_<token>`.
DATABASE_BLOB_READ_WRITE_TOKEN=

# Purpose: Preferred Blob access tier when uploading AES-256-GCM encrypted database backup
#          archives into Vercel Blob (`databaseManagerPlugin`).
# Type: String (Enum)
# Format: Must be `public` or `private` (automatically falls back if store only supports `public`).
# Example / Default: `public` (or `private` when paired with a private Vercel Blob store).
DATABASE_BLOB_ACCESS=

# Purpose: Dedicated passphrase used via PBKDF2-HMAC-SHA256 to derive the 256-bit AES-256-GCM
#          key for encrypting/decrypting portable `.json`, `.ndjson`, `.sql`, and `.csv` DB backups.
# Type: String (High-entropy secret)
# Format: 32+ random characters recommended (falls back to `PAYLOAD_SECRET` when empty).
# Example / Default: Leave empty locally, or `db_vault_key_4e89c1a73f20b6d591e4a8c27d03f6b1`.
DATABASE_BACKUP_SECRET=


# ------------------------------------------------------------------------------
# 5. Email, Forms & Mail Inbox (`@payloadcms/email-resend`, `@payloadcms/plugin-form-builder`, `mailInboxPlugin`)
# ------------------------------------------------------------------------------

# Purpose: Resend API key powering Payload transactional emails (password reset/auth),
#          `/contact` & `Request CV` form notifications, outbound `/admin/inbox` sending,
#          and inbound MIME + signed attachment fetching from Resend Receiving API.
# Type: String (API Key)
# Format: Resend secret key prefixed with `re_` (`re_<alphanumeric_token>`).
# Example / Default: Leave empty locally (forms & inbox drafts still work offline), or `re_<your_resend_api_key>`.
RESEND_API_KEY=

# Purpose: Standard Webhooks / Svix signing secret used by `POST /api/webhooks/resend` to
#          verify constant-time HMAC-SHA256 signatures and ±5-minute replay windows for
#          `email.received` and outbound delivery telemetry (`delivered`, `bounced`, `opened`).
# Type: String (Base64 Signing Secret)
# Format: Must start with `whsec_` followed by valid Base64 (`whsec_<base64_secret>`).
# Example / Default: Leave empty locally, or `whsec_<your_svix_base64_signing_secret>`.
RESEND_WEBHOOK_SECRET=

# Purpose: Default destination email address seeded and used by `@payloadcms/plugin-form-builder`
#          for visitor Contact and Request-CV form notification emails.
# Type: String (Email Address)
# Format: Valid RFC 5322 email address (`user@domain.tld`).
# Example / Default: `dev@vtarikhi.com`.
CONTACT_NOTIFICATION_EMAIL=dev@vtarikhi.com


# ------------------------------------------------------------------------------
# 6. Serverless Postgres Provider APIs (`@neon/sdk`, `/admin/database` Tier-2 Adapters)
# ------------------------------------------------------------------------------

# Purpose: Neon Management API key unlocking Tier-2 controls in `/admin/database` via `@neon/sdk`
#          (instant CoW snapshots, PITR branches, compute scaling, pre-restore safety snapshots).
# Type: String (API Key)
# Format: Neon Personal or Organization API key prefixed with `napi_` (`napi_<alphanumeric>`).
# Example / Default: Leave empty if not using Neon API controls, or `napi_<your_neon_api_key>`.
NEON_API_KEY=

# Purpose: Explicit Neon project ID override when a Neon API key has access to multiple projects.
#          Auto-detected from the `POSTGRES_URL` endpoint hostname when omitted.
# Type: String
# Format: Hyphenated Neon project slug (`<word>-<word>-<digits>`).
# Example / Default: Leave empty for auto-detection, or `icy-lake-12345678`.
NEON_PROJECT_ID=

# Purpose: Explicit Neon branch ID override targeting a specific database branch in `/admin/database`.
#          Auto-detected from `POSTGRES_URL` when omitted.
# Type: String
# Format: Neon branch identifier prefixed with `br-` (`br-<name>-<id>`).
# Example / Default: Leave empty for auto-detection, or `br-main-a1b2c3d4`.
NEON_BRANCH_ID=

# Purpose: Supabase Management API Personal Access Token enabling Tier-2 database provider
#          diagnostics and controls when PostgreSQL is hosted on Supabase.
# Type: String (Bearer Token)
# Format: Supabase PAT prefixed with `sbp_` followed by 40 lowercase hex characters (`sbp_<40-hex-chars>`).
# Example / Default: Leave empty unless using Supabase, e.g., `sbp_<your_40_char_supabase_pat>`.
SUPABASE_ACCESS_TOKEN=

# Purpose: 20-character Supabase project reference ID. Auto-detected from `POSTGRES_URL`
#          pooler username (`postgres.<project-ref>`) when omitted.
# Type: String
# Format: 20 lowercase alphanumeric characters (`^[a-z0-9]{20}$`).
# Example / Default: Leave empty for auto-detection, or `abcdefghijklmnopqrst`.
SUPABASE_PROJECT_REF=

# Purpose: Prisma Data Platform service token enabling Tier-2 status & management integration
#          when using Prisma Postgres (`databaseManagerPlugin`).
# Type: String (Bearer Token)
# Format: Non-empty Prisma Data Platform service token string.
# Example / Default: Leave empty unless using Prisma Postgres, e.g., `pdp_st_0123456789abcdef`.
PRISMA_SERVICE_TOKEN=

# Purpose: Target Prisma Postgres database identifier paired with `PRISMA_SERVICE_TOKEN`.
# Type: String
# Format: Prisma Data Platform database ID string.
# Example / Default: Leave empty unless using Prisma Postgres, e.g., `db_01J9XYZABCDEF123456`.
PRISMA_DATABASE_ID=


# ------------------------------------------------------------------------------
# 7. Admin Observability Widgets (`@vercel/analytics`, `@vercel/speed-insights`, Google & GitHub APIs)
# ------------------------------------------------------------------------------

# Purpose: Vercel REST API access token powering the Admin Dashboard "Site traffic"
#          (Web Analytics) and "Deployments" widgets (`src/integrations/vercel.ts`).
# Type: String (Bearer Token)
# Format: Token created in Vercel Account Settings -> Tokens (24+ alphanumeric chars).
# Example / Default: Leave empty locally (widgets show a clean setup hint), or `vcel_0123456789abcdefABCDEF01`.
VERCEL_TOKEN=

# Purpose: Vercel project identifier queried by the Site traffic and Deployments widgets.
# Type: String
# Format: Project ID from Vercel Project Settings -> General, prefixed with `prj_`.
# Example / Default: Leave empty locally, or `prj_0123456789abcdefghijklmnopqr`.
VERCEL_PROJECT_ID=

# Purpose: Vercel Team ID required when the Vercel project belongs to a Team workspace.
# Type: String
# Format: Team identifier prefixed with `team_`.
# Example / Default: Leave empty for personal Vercel accounts, or `team_0123456789abcdef`.
VERCEL_TEAM_ID=

# Purpose: Alternative human-readable Vercel Team slug accepted alongside `VERCEL_TEAM_ID`.
# Type: String
# Format: Lowercase URL-safe team slug (`[a-z0-9-]+`).
# Example / Default: Leave empty for personal accounts, or `etarikhi-studio`.
VERCEL_TEAM_SLUG=

# Purpose: Google Cloud API key with "PageSpeed Insights API" and "Chrome UX Report API"
#          enabled, powering Core Web Vitals & Lighthouse scores on the Admin Dashboard.
# Type: String (API Key)
# Format: Google Cloud API key prefixed with `AIza` (39 characters).
# Example / Default: Leave empty locally, or `AIzaSy_<your_33_char_google_api_key>`.
GOOGLE_API_KEY=

# Purpose: Optional auxiliary PageSpeed API key checked by `/admin/system` integration diagnostics.
# Type: String (API Key)
# Format: Google Cloud API key prefixed with `AIza` (can match `GOOGLE_API_KEY`).
# Example / Default: Leave empty locally, or `AIzaSy_<your_33_char_google_api_key>`.
PAGESPEED_API_KEY=

# Purpose: GitHub repository identifier queried by the Admin Dashboard "CI status"
#          (GitHub Actions) widget. Auto-detected on Vercel from Git metadata when empty.
# Type: String
# Format: `<owner>/<repository>` (exact owner and repo name separated by a single `/`).
# Example / Default: `eTarikhi/PoCMS-Payload`.
GITHUB_REPOSITORY=eTarikhi/PoCMS-Payload

# Purpose: Companion GitHub repository identifier read by `/admin/system` readiness checks.
# Type: String
# Format: `<owner>/<repository>` matching `GITHUB_REPOSITORY`.
# Example / Default: `eTarikhi/PoCMS-Payload`.
GITHUB_REPO=eTarikhi/PoCMS-Payload

# Purpose: Fine-grained GitHub Personal Access Token granting private-repo Actions read access
#          and raising GitHub API rate limits from 60 req/hr to 5,000 req/hr.
# Type: String (Bearer Token)
# Format: Fine-grained PAT (`github_pat_...`) or classic PAT (`ghp_...`) with `Actions: Read-only`.
# Example / Default: Leave empty for public repos with low traffic, or `github_pat_<your_fine_grained_token>`.
GITHUB_TOKEN=


# ------------------------------------------------------------------------------
# 8. Vercel System-Injected Metadata (Optional Local Simulation Only)
# ------------------------------------------------------------------------------
# Note: Vercel populates these automatically on Preview & Production deployments.
# Leave them empty in `.env` unless locally testing environment badges in DevTools.

# Purpose: Indicates the active Vercel deployment tier displayed in Admin DevTools & System Info.
# Type: String (Enum)
# Format: `production`, `preview`, or `development` (auto-set by Vercel).
# Example / Default: Leave empty locally.
VERCEL_ENV=

# Purpose: Production domain hostname injected by Vercel (fallback target for PageSpeed widget).
# Type: String (Hostname)
# Format: Bare domain hostname without `https://` scheme (e.g., `vtarikhi.com`).
# Example / Default: Leave empty locally.
VERCEL_PROJECT_PRODUCTION_URL=

# Purpose: Git commit SHA displayed as a 7-character badge in Admin DevTools & `/admin/system`.
# Type: String (Git SHA-1)
# Format: 40-character hexadecimal Git commit hash (auto-set by Vercel).
# Example / Default: Leave empty locally, or `fe3447a000000000000000000000000000000000`.
VERCEL_GIT_COMMIT_SHA=

# Purpose: Git repository owner fallback used by the GitHub CI widget when `GITHUB_REPOSITORY` is unset.
# Type: String
# Format: GitHub user or organization handle without slashes.
# Example / Default: Leave empty locally (e.g., `eTarikhi`).
VERCEL_GIT_REPO_OWNER=

# Purpose: Git repository slug fallback paired with `VERCEL_GIT_REPO_OWNER` on Vercel deployments.
# Type: String
# Format: GitHub repository name without owner prefix.
# Example / Default: Leave empty locally (e.g., `PoCMS-Payload`).
VERCEL_GIT_REPO_SLUG=


# ------------------------------------------------------------------------------
# 9. Automated Testing & CI (`@playwright/test@1.58.2`, `vitest@4.0.18`)
# ------------------------------------------------------------------------------

# Purpose: Target HTTP base URL navigated by Playwright end-to-end and `@axe-core/playwright`
#          WCAG accessibility test suites (`playwright.config.ts`).
# Type: URL
# Format: Full `http://` or `https://` origin URL without trailing slash.
# Example / Default: `http://localhost:3000`.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Purpose: Indicates execution inside an automated Continuous Integration pipeline, tuning
#          Playwright (`forbidOnly: true`, `retries: 2`, `workers: 1`, fresh webServer start).
# Type: Boolean
# Format: `true` or `1` in CI environments; leave empty locally.
# Example / Default: Leave empty locally; `true` in GitHub Actions.
CI=
