{
  "name": "PoCMS-Payload",
  "version": "1.0.0",
  "description": "Portfolio Content Management System with Payload 3.0 Headless CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:compile": "cross-env next build --experimental-build-mode compile",
    "build:generate": "cross-env next build --experimental-build-mode generate",
    "build:all": "cross-env next build --experimental-build-mode compile && cross-env next build --experimental-build-mode generate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:graphQLSchema": "node scripts/generate.mjs graphql",
    "generate:importmap": "node scripts/generate.mjs importmap",
    "generate:types": "node scripts/generate.mjs types",
    "generate:all": "node scripts/generate.mjs types importmap db-schema graphql && node scripts/generate-nav-icons.mjs",
    "generate:nav-icons": "node scripts/generate-nav-icons.mjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "check:tw-prefix": "node scripts/check-tw-prefix.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:dev": "cross-env pnpm generate:all && pnpm build:all && pnpm start",
    "restart": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm generate:all && pnpm build:all && pnpm start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx ./src/seed/seed.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts e2e/",
    "test:visual": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts visual/",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@payloadcms/db-vercel-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/graphql": "^3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^12.43.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "allowScripts": {
    "esbuild": true,
    "bufferutil": true,
    "unrs-resolver": true,
    "file:../esbuild@0.28.2/node_modules/esbuild": true,
    "file:../../esbuild@0.28.2/node_modules/esbuild": true,
    "file:../../esbuild@0.25.12/node_modules/esbuild": true,
    "file:../../esbuild@0.18.20/node_modules/esbuild": true,
    "file:../../bufferutil@4.1.0/node_modules/bufferutil": true,
    "file:../../unrs-resolver@1.12.2/node_modules/unrs-resolver": true
  }
}
