{
  "name": "PoCMS-Payload",
  "version": "1.0.0",
  "description": "Portfolio Content Management System with Payload 3.0 Headless CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:compile": "cross-env next build --experimental-build-mode compile",
    "build:generate": "cross-env next build --experimental-build-mode generate",
    "build:all": "cross-env next build --experimental-build-mode compile && cross-env next build --experimental-build-mode generate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:all": "payload generate:types && payload generate:importmap && payload generate:db-schema && payload-graphql generate:schema",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:dev": "cross-env pnpm generate:all && pnpm build:all && pnpm start",
    "restart": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm generate:all && pnpm build:all && pnpm start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx ./src/seed/seed.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {

    "payload": "3.90.2",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-vercel-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/graphql": "^3.90.2",
    "@payloadcms/next": "3.90.2",

    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",

    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",

    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "framer-motion": "^12.43.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",

    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-auto-scroll": "^8.1.5",
    "embla-carousel-react": "^8.5.2",
    "graphql": "^16.8.1",
    "@apollo/client": "^4.3.2",
    "jsonwebtoken": "9.0.1",
    "lucide-react": "0.563.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "next-themes": "0.4.6",
    "prism-react-renderer": "^2.3.1",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "sonner": "^1.7.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "@eslint/eslintrc": "^3.3.7",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
